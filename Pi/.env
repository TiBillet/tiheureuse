# --- RFID (choisissez un type) ---
RFID_TYPE=RC522
# RFID_TYPE=VMA405

# BOARD (physique) ou BCM (GPIO)
GPIO_MODE=BOARD

# Pour RC522 (ignorez si VMA405)
RC522_RST_PIN=22
RC522_SDA_PIN=24

# Pour VMA405 (ignorez si RC522)
#RFID_DEVICE=/dev/ttyS0
#VMA405_PORT=/dev/ttyUSB0
#VMA405_BAUDRATE=9600

# --- Vanne ---
# GPIO_VANNE : pin lue par hardware/valve.py (driver pigpio)
GPIO_VANNE=12
VALVE_ACTIVE_HIGH=False

# --- Débitmètre ---
# GPIO_FLOW_SENSOR : pin lue par hardware/flow_meter.py (driver pigpio)
GPIO_FLOW_SENSOR=16
FLOW_CALIBRATION_FACTOR=6.5

# --- Backend ---
BACKEND_HOST=192.168.1.10
BACKEND_PORT=8000
NETWORK_TIMEOUT=5.0
MAX_RETRIES=3
BACKEND_API_KEY=changeme   # Doit correspondre à AGENT_SHARED_KEY dans Django settings.py

# --- Logs ---
LOG_LEVEL=INFO

# --- Systemd ---
SYSTEMD_NOTIFY=True

# --- Git Update ---
GIT_REPO=git@github.com:TiBillet/tiheureuse.git
GIT_BRANCH=master